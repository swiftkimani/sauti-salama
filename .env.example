# ---- Server -----------------------------------------------------------------
PORT=3000
# Public HTTPS URL Africa's Talking can reach (ngrok/cloudflared tunnel while testing).
PUBLIC_BASE_URL=http://localhost:3000

# ---- Database ---------------------------------------------------------------
# sqljs  = zero-setup file database (default, good for the PoC)
# postgres = production (docker-compose.yml starts one)
DB_TYPE=sqljs
DATABASE_URL=postgres://sauti:sauti@localhost:5432/sauti
# SQLITE_PATH=./data/sauti-salama.sqlite

# ---- Privacy ----------------------------------------------------------------
# 64 hex chars (32 bytes). Generate with: npm run keygen
ENCRYPTION_KEY=
HASH_PEPPER=change-me-to-a-long-random-string
DASHBOARD_TOKEN=demo-token
# Required once the server is public (tunnel or deploy): Africa's Talking callbacks must carry ?key=<this>.
# Generate with: npm run keygen
WEBHOOK_SECRET=
RETENTION_DAYS=90

# ---- AI ---------------------------------------------------------------------
# anthropic = Claude API triage (needs ANTHROPIC_API_KEY); rules = offline keyword triage
AI_PROVIDER=
ANTHROPIC_API_KEY=
# Check https://platform.claude.com/docs/en/about-claude/models/overview for current IDs.
ANTHROPIC_MODEL=claude-sonnet-5
AI_TIMEOUT_MS=12000
# openai = Whisper transcription of voice recordings (needs OPENAI_API_KEY); mock = sample text
TRANSCRIBE_PROVIDER=
OPENAI_API_KEY=

# ---- Africa's Talking -------------------------------------------------------
# Sandbox: username "sandbox" and an API key generated inside the sandbox app. Live: your app's username and key.
AT_USERNAME=sandbox
AT_API_KEY=
# Optional. Your SMS shortcode (so replies thread with what the survivor texted) or an approved alphanumeric sender ID.
AT_SENDER_ID=
COUNSELLOR_NUMBERS=
# Optional: base URL of pre-recorded Kiswahili voice prompts (mp3). Blank = text-to-speech.
SW_AUDIO_BASE_URL=

# ---- Responders (demo) ------------------------------------------------------
# Your own phone: every Tier-1 alert in the demo is sent here.
DEMO_RESPONDER_PHONE=+254700000000
TIER2_RESPONDER_PHONE=
ESCALATION_MINUTES=10
