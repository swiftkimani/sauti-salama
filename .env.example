# ---- Server -----------------------------------------------------------------
# NODE_ENV=production refuses to start without real secrets, https PUBLIC_BASE_URL and Postgres (docs/RUNBOOK.md).
# NODE_ENV=
PORT=3000
# Public HTTPS URL Africa's Talking can reach (ngrok/cloudflared tunnel while testing).
PUBLIC_BASE_URL=http://localhost:3000
# Express trust proxy. Default "loopback" suits a tunnel or proxy on this host.
TRUST_PROXY=
# Comma-separated origins allowed to call the API from another site (none needed for the bundled console).
CORS_ORIGINS=

# ---- Database ---------------------------------------------------------------
# sqljs  = zero-setup file database (default, good for the PoC)
# postgres = production (docker-compose.yml starts one)
DB_TYPE=sqljs
DATABASE_URL=postgres://sauti:sauti@localhost:5432/sauti
# Postgres schema comes from migrations, applied on start. DB_SYNC=true only on a throwaway dev database.
DB_MIGRATE_ON_START=true
DB_SYNC=false
# SQLITE_PATH=./data/sauti-salama.sqlite

# ---- Privacy ----------------------------------------------------------------
# 64 hex chars (32 bytes). Generate with: npm run keygen
ENCRYPTION_KEY=
HASH_PEPPER=change-me-to-a-long-random-string
DASHBOARD_TOKEN=demo-token
# Required once the server is public (tunnel or deploy): Africa's Talking callbacks must carry ?key=<this>.
# Generate with: npm run keygen
WEBHOOK_SECRET=
RETENTION_DAYS=90
# Cases never closed are purged after this many days without an update. 0 = keep.
RETENTION_OPEN_DAYS=365

# ---- AI ---------------------------------------------------------------------
# groq = Groq (default when GROQ_API_KEY is set) | anthropic = Claude API | rules = offline keyword triage
AI_PROVIDER=
# Free key: https://console.groq.com/keys  (used for triage AND call-recording transcription)
GROQ_API_KEY=
# Strict JSON-schema output; alternatives: openai/gpt-oss-20b (faster), llama-3.3-70b-versatile (JSON mode)
GROQ_MODEL=openai/gpt-oss-120b
# whisper-large-v3 is the most accurate for Kiswahili; whisper-large-v3-turbo is cheaper and faster
GROQ_TRANSCRIBE_MODEL=whisper-large-v3
ANTHROPIC_API_KEY=
# Check https://platform.claude.com/docs/en/about-claude/models/overview for current IDs.
ANTHROPIC_MODEL=claude-sonnet-5
AI_TIMEOUT_MS=12000
# groq (default with GROQ_API_KEY) | openai (needs OPENAI_API_KEY) | mock = labelled sample text (never in production)
TRANSCRIBE_PROVIDER=
OPENAI_API_KEY=
# Hosts call recordings may be downloaded from (and their subdomains). Confirm with a real call before go-live.
RECORDING_URL_HOSTS=africastalking.com
TRANSCRIBE_TIMEOUT_MS=60000
# Ceiling on paid AI calls (triage + transcription). Above it: rules triage / untranscribed case. 0 = off.
AI_MAX_CALLS_PER_MINUTE=60

# ---- Africa's Talking -------------------------------------------------------
# Sandbox: username "sandbox" and an API key generated inside the sandbox app. Live: your app's username and key.
AT_USERNAME=sandbox
AT_API_KEY=
# Optional. Your SMS shortcode (so replies thread with what the survivor texted) or an approved alphanumeric sender ID.
AT_SENDER_ID=
SMS_TIMEOUT_MS=15000
# Numbers voice option 3 connects to. Empty: the call logs a call-back request instead.
COUNSELLOR_NUMBERS=
# How many questions the call line may ask before it takes consent and lets the caller go.
CALL_MAX_QUESTIONS=5

# ---- Responders (demo) ------------------------------------------------------
# Your own phone: every Tier-1 alert in the demo is sent here.
DEMO_RESPONDER_PHONE=+254700000000
TIER2_RESPONDER_PHONE=
ESCALATION_MINUTES=10

# ---- Abuse protection -------------------------------------------------------
# New cases per phone per hour; further reports are added to that phone's latest case. 0 = off.
RATE_LIMIT_REPORTS_PER_HOUR=3
# HELP/MSAADA information replies per phone per hour.
RATE_LIMIT_INFO_PER_HOUR=5
# Any SMS replies to one unregistered number per hour.
RATE_LIMIT_REPLIES_PER_HOUR=10
# Per client IP. Africa's Talking calls from few IPs, so the webhook limit is effectively line-wide.
API_RATE_LIMIT_PER_MINUTE=300
WEBHOOK_RATE_LIMIT_PER_MINUTE=600
