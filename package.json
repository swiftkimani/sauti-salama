{
  "name": "sauti-salama",
  "version": "0.1.0",
  "private": true,
  "description": "Sauti Salama - an offline-first, AI-assisted gender-based violence reporting and referral line (voice call line, USSD, SMS) built for Kenya. OSF x Andela Hackathon 2026 proof of concept.",
  "license": "MIT",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "dev": "ts-node src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "test": "jest",
    "test:cov": "jest --coverage",
    "lint": "eslint src test scripts/openapi.ts",
    "demo": "bash scripts/demo.sh",
    "demo:video": "node scripts/build-demo-video.js",
    "demo:video:vo": "node scripts/build-demo-video.js --voice",
    "tunnel": "cloudflared tunnel --url http://localhost:3000",
    "live": "bash scripts/live.sh",
    "at:check": "node scripts/at-check.js",
    "ai:check": "node scripts/ai-check.js",
    "keygen": "node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\"",
    "migration:run": "typeorm -d dist/config/data-source.js migration:run",
    "migration:revert": "typeorm -d dist/config/data-source.js migration:revert",
    "migration:generate": "typeorm-ts-node-commonjs -d src/config/data-source.ts migration:generate",
    "migration:check": "typeorm-ts-node-commonjs -d src/config/data-source.ts migration:generate --check src/migrations/Pending",
    "openapi": "ts-node scripts/openapi.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/throttler": "^6.7.0",
    "@nestjs/typeorm": "^10.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "dotenv": "^16.6.1",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sql.js": "^1.10.3",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/testing": "^10.4.22",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.10",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/test"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "setupFiles": [
      "<rootDir>/test/setup-env.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/main.ts",
      "!src/migrations/**",
      "!src/config/data-source.ts"
    ],
    "coverageReporters": [
      "text-summary",
      "lcov"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 80,
        "branches": 65,
        "functions": 75,
        "lines": 85
      }
    }
  },
  "overrides": {
    "lodash": "4.18.1",
    "multer": "2.4.0",
    "qs": "6.16.0",
    "body-parser": "1.20.8",
    "@nestjs/swagger": {
      "js-yaml": "4.3.2"
    },
    "@nestjs/typeorm": {
      "uuid": "11.1.1"
    }
  }
}
