{
  "name": "sauti-salama",
  "version": "0.1.0",
  "private": true,
  "description": "Sauti Salama - an offline-first, AI-assisted gender-based violence reporting and referral line (voice call line, USSD, SMS) built for Kenya. OSF x Andela Hackathon 2026 proof of concept.",
  "license": "MIT",
  "engines": { "node": ">=18.17" },
  "scripts": {
    "dev": "ts-node src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "test": "jest",
    "demo": "bash scripts/demo.sh",
    "tunnel": "cloudflared tunnel --url http://localhost:3000",
    "live": "bash scripts/live.sh",
    "at:check": "node scripts/at-check.js",
    "keygen": "node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\""
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/typeorm": "^10.0.2",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sql.js": "^1.10.3",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.10",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": ["<rootDir>/test"],
    "testRegex": ".*\\.spec\\.ts$"
  }
}
