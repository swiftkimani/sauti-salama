  "info": {
    "title": "Sauti Salama API",
    "description": "Responder console API (`/api`, header `x-dashboard-token`) and the Africa's Talking callbacks (`/webhooks`, `?key=<WEBHOOK_SECRET>`).\n\nWebhook bodies are application/x-www-form-urlencoded, as Africa's Talking sends them.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "dashboard-token": {
        "type": "apiKey",
        "in": "header",
        "name": "x-dashboard-token"
      }
    },
    "schemas": {
      "VoiceCallbackDto": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string"
          },
          "isActive": {
            "type": "string",
            "example": "1"
          },
          "direction": {
            "type": "string"
          },
          "callerNumber": {
            "type": "string"
          },
          "destinationNumber": {
            "type": "string"
          },
          "dtmfDigits": {
            "type": "string"
          },
          "recordingUrl": {
            "type": "string"
          },
          "durationInSeconds": {
            "type": "string"
          },
          "callSessionState": {
            "type": "string"
          },
          "hangupCause": {
            "type": "string"
          },
          "mockTranscript": {
            "type": "string",
            "description": "Simulator only (ignored in production): the text to use instead of transcribing"
          }
        },
        "required": [
          "sessionId"
        ]
      },
      "UssdCallbackDto": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string"
          },
          "phoneNumber": {
            "type": "string",
            "example": "+254712345678"
          },
          "serviceCode": {
            "type": "string",
            "example": "*384*7262#"
          },
          "text": {
            "type": "string",
            "example": "2*1*2",
            "description": "Everything the user entered this session, joined by *"
          },
          "networkCode": {
            "type": "string"
          }
        },
        "required": [
          "sessionId",
          "phoneNumber"
        ]
      },
      "SmsInboundDto": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "example": "+254712345678"
          },
          "to": {
            "type": "string",
            "example": "7262"
          },
          "text": {
            "type": "string",
            "description": "Message text (long messages arrive concatenated)"
          },
          "date": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "linkId": {
            "type": "string"
          }
        },
        "required": [
          "from",
          "text"
        ]
      },
      "SmsDeliveryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "example": "Success"
          },
          "phoneNumber": {
            "type": "string"
          },
          "failureReason": {
            "type": "string"
          },
          "networkCode": {
            "type": "string"
          },
          "retryCount": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ]
      },
      "ActorDto": {
        "type": "object",
        "properties": {
          "actor": {
            "type": "string",
            "example": "Amina W.",
            "maxLength": 80,
            "description": "Name recorded in the audit trail. Defaults to \"console\"."
          }
        }
      },
      "ResolveDto": {
        "type": "object",
        "properties": {
          "actor": {
            "type": "string",
            "example": "Amina W.",
            "maxLength": 80,
            "description": "Name recorded in the audit trail. Defaults to \"console\"."
          },
          "outcome": {
            "type": "string",
            "enum": [
              "RESOLVED",
              "FALSE_ALARM"
            ],
            "default": "RESOLVED"
          },
          "note": {
            "type": "string",
            "maxLength": 500
          }
        }
      }
    }
  }
}
